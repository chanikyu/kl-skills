{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\" session-start",
            "commandWindows": "powershell -NoProfile -ExecutionPolicy Bypass -File \"$env:CLAUDE_PLUGIN_ROOT\\hooks\\run.ps1\" session-start",
            "timeout": 5,
            "statusMessage": "Loading kl-skills gates...",
            "description": "Announce that the kl-skills gate binary is live. Install smoke test.",
            "id": "session-start:banner"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\" wiki-index-check",
            "commandWindows": "powershell -NoProfile -ExecutionPolicy Bypass -File \"$env:CLAUDE_PLUGIN_ROOT\\hooks\\run.ps1\" wiki-index-check",
            "timeout": 5,
            "description": "Warn when a page written under ~/llm-wiki-docs/<topic>/wiki/ is not listed in that wiki's index.md. Warns only; never blocks.",
            "id": "post-write:wiki-index-check"
          },
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\" wiki-graph",
            "commandWindows": "powershell -NoProfile -ExecutionPolicy Bypass -File \"$env:CLAUDE_PLUGIN_ROOT\\hooks\\run.ps1\" wiki-graph",
            "timeout": 60,
            "statusMessage": "Updating wiki graph...",
            "description": "A page under ~/llm-wiki-docs/<topic>/wiki/ was written: rebuild the graph db so the graph view is never behind the wiki. Exits immediately for every other file.",
            "id": "post-write:wiki-graph"
          },
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\" prose-check",
            "commandWindows": "powershell -NoProfile -ExecutionPolicy Bypass -File \"$env:CLAUDE_PLUGIN_ROOT\\hooks\\run.ps1\" prose-check",
            "timeout": 30,
            "statusMessage": "Checking prose...",
            "description": "A wiki page was written: point at omissions a reader would stumble on (undefined terms, numbers with no baseline, missing subjects). Warns only; never blocks. Exits immediately for every other file.",
            "id": "post-write:prose-check"
          },
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\" code-check",
            "commandWindows": "powershell -NoProfile -ExecutionPolicy Bypass -File \"$env:CLAUDE_PLUGIN_ROOT\\hooks\\run.ps1\" code-check",
            "timeout": 30,
            "statusMessage": "Checking names and comments...",
            "description": "A python file was written: report vague names, missing docstrings and long functions with no comment inside. Caches, virtualenvs and scratch paths are skipped. Reports; never blocks.",
            "id": "post-write:code-check"
          },
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\" plan-drift",
            "commandWindows": "powershell -NoProfile -ExecutionPolicy Bypass -File \"$env:CLAUDE_PLUGIN_ROOT\\hooks\\run.ps1\" plan-drift",
            "timeout": 60,
            "statusMessage": "Checking the plan...",
            "description": "A plan (a document defining L1-style goals) was written: check its frame and whether recorded work follows it. Reports; never blocks.",
            "id": "post-write:plan-drift"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\" after-bash",
            "commandWindows": "powershell -NoProfile -ExecutionPolicy Bypass -File \"$env:CLAUDE_PLUGIN_ROOT\\hooks\\run.ps1\" after-bash",
            "timeout": 120,
            "description": "After every Bash call, two cheap checks in Rust: was a wiki page changed by the shell, and was this a git commit. Only a real change pays for the Python work (wiki sync, plan drift). One gate, so the launcher cost is paid once per Bash call. Reports; never blocks.",
            "id": "post-bash:after-bash"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\" wiki-sync",
            "commandWindows": "powershell -NoProfile -ExecutionPolicy Bypass -File \"$env:CLAUDE_PLUGIN_ROOT\\hooks\\run.ps1\" wiki-sync",
            "timeout": 120,
            "statusMessage": "Syncing wiki graph...",
            "description": "Once per session: rebuild the graph db and check any wiki page that changed, no matter how it was written. The PostToolUse gates only see Write/Edit, and a model often writes files with Bash. Reports; never blocks.",
            "id": "stop:wiki-sync"
          },
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\" answer-check",
            "commandWindows": "powershell -NoProfile -ExecutionPolicy Bypass -File \"$env:CLAUDE_PLUGIN_ROOT\\hooks\\run.ps1\" answer-check",
            "timeout": 30,
            "statusMessage": "Checking the answer...",
            "description": "Read the answer just given and block once if it misses: the same question asked again, an answer past one screen, or prose findings. Blocking is capped by stop_hook_active so it cannot loop.",
            "id": "stop:answer-check"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\" wiki-recall",
            "commandWindows": "powershell -NoProfile -ExecutionPolicy Bypass -File \"$env:CLAUDE_PLUGIN_ROOT\\hooks\\run.ps1\" wiki-recall",
            "timeout": 20,
            "description": "Every message: search the wiki and attach the paths and key lines of clearly related pages (at least two shared words and 40% weighted coverage). Silent when nothing is clearly related.",
            "id": "prompt:wiki-recall"
          }
        ]
      }
    ]
  }
}
